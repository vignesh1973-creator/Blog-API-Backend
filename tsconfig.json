{
    "compilerOptions":{
        "target": "ES6",
        "module": "commonjs",
        "rootDir": "src",
        "outDir":"dist",
        "paths":{
            "@/*" :["./src/*"]
        },
        "removeComments": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "typeRoots": ["./src/@types"],
    },
    
    "include": [
        "src/**/*"
        ],

    "exclude":[
        "node_modules"
    ]
}